{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "loop-executor": {
      "description": "Implements the task passed by the agent loop; edits files and runs repo commands.",
      "mode": "primary",
      "system": "You are the loop-executor. Implement the task you are given, in this repository only. Rules: (1) keep changes minimal and consistent with existing style; (2) never commit, tag, or push; (3) never read or write secret files such as login.json, .env*, *.key, *.pem, *.pfx or *.p12; (4) if a credential, destructive action, or scope decision is required that was not given, stop and say exactly what is missing instead of guessing; (5) if the task is ambiguous, make the smallest interpretation and state it plainly. Report what you changed and how you verified it.",
      "steps": 40,
      "permissions": [
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "allow" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "webfetch", "resource": "*", "effect": "deny" },
        { "action": "websearch", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "git push*", "effect": "deny" },
        { "action": "shell", "resource": "git commit*", "effect": "deny" },
        { "action": "shell", "resource": "git tag*", "effect": "deny" },
        { "action": "shell", "resource": "git reset --hard*", "effect": "deny" },
        { "action": "shell", "resource": "git clean*", "effect": "deny" },
        { "action": "shell", "resource": "git checkout --*", "effect": "deny" },
        { "action": "shell", "resource": "rm *", "effect": "deny" },
        { "action": "shell", "resource": "rm -*", "effect": "deny" },
        { "action": "shell", "resource": "del *", "effect": "deny" },
        { "action": "shell", "resource": "Remove-Item*", "effect": "deny" },
        { "action": "shell", "resource": "rmdir*", "effect": "deny" },
        { "action": "shell", "resource": "rd *", "effect": "deny" },
        { "action": "shell", "resource": "reg *", "effect": "deny" },
        { "action": "shell", "resource": "sc *", "effect": "deny" },
        { "action": "shell", "resource": "shutdown*", "effect": "deny" },
        { "action": "shell", "resource": "gh *", "effect": "deny" },
        { "action": "shell", "resource": "npm publish*", "effect": "deny" },
        { "action": "shell", "resource": "dotnet nuget push*", "effect": "deny" },
        { "action": "read", "resource": "*login.json", "effect": "deny" },
        { "action": "read", "resource": ".env*", "effect": "deny" },
        { "action": "read", "resource": "*.pfx", "effect": "deny" },
        { "action": "read", "resource": "*.pem", "effect": "deny" },
        { "action": "read", "resource": "*.key", "effect": "deny" },
        { "action": "read", "resource": "*.p12", "effect": "deny" },
        { "action": "edit", "resource": "*login.json", "effect": "deny" },
        { "action": "edit", "resource": ".env*", "effect": "deny" },
        { "action": "edit", "resource": "*.pfx", "effect": "deny" },
        { "action": "edit", "resource": "*.pem", "effect": "deny" },
        { "action": "edit", "resource": "*.key", "effect": "deny" }
      ]
    },
    "loop-reviewer": {
      "description": "Independent read-only reviewer used by the agent loop; reports findings with severity.",
      "mode": "primary",
      "system": "You are an independent reviewer for this repository. Review only; never edit files. You may read files and run read-only git commands. Check for: correctness, broken behavior, security issues, incorrect tests, and unnecessary changes. After your analysis, output exactly one final line in this format: VERDICT: {\"verdict\":\"pass|fail|critical\",\"findings\":[{\"severity\":\"critical|major|minor\",\"file\":\"path\",\"line\":0,\"message\":\"short description\"}]}. Use pass only when there is nothing that must change; fail when something must change but none is catastrophic; critical when the change is broken, leaks secrets, or must not ship.",
      "steps": 16,
      "permissions": [
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "git diff*", "effect": "allow" },
        { "action": "shell", "resource": "git log*", "effect": "allow" },
        { "action": "shell", "resource": "git status*", "effect": "allow" },
        { "action": "shell", "resource": "git branch*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "webfetch", "resource": "*", "effect": "deny" },
        { "action": "websearch", "resource": "*", "effect": "deny" },
        { "action": "read", "resource": "*login.json", "effect": "deny" },
        { "action": "read", "resource": ".env*", "effect": "deny" },
        { "action": "read", "resource": "*.pfx", "effect": "deny" },
        { "action": "read", "resource": "*.pem", "effect": "deny" },
        { "action": "read", "resource": "*.key", "effect": "deny" }
      ]
    }
  }
}

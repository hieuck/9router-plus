                        <Border Style="{StaticResource SettingsSectionStyle}">
                            <StackPanel>
                                <!-- Section Header with Icon -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                    <TextBlock Text="🎨" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="Giao diện" Style="{StaticResource SettingsSectionTitleStyle}" Margin="0" />
                                </StackPanel>
                                <TextBlock Text="Tùy chỉnh cách hiển thị của ứng dụng."
                                           Style="{StaticResource SettingsSectionDescriptionStyle}" />
                                
                                <!-- Theme Toggle Buttons -->
                                <TextBlock Text="Chủ đề" Style="{StaticResource SettingsFieldLabelStyle}" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <RadioButton Content="☀️ Sáng" 
                                                 IsChecked="{Binding UseLightTheme, Mode=TwoWay}"
                                                 GroupName="Theme"
                                                 Padding="12,8"
                                                 MinWidth="90">
                                        <RadioButton.Style>
                                            <Style TargetType="RadioButton">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="RadioButton">
                                                            <Border x:Name="Border"
                                                                    Background="{DynamicResource PanelLightBrush}"
                                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="8"
                                                                    Padding="{TemplateBinding Padding}"
                                                                    Cursor="Hand">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="Border" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                                    <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource AccentContentBrush}" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </Trigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </RadioButton.Style>
                                    </RadioButton>
                                    <RadioButton Content="🌙 Tối" 
                                                 IsChecked="{Binding UseLightTheme, Mode=TwoWay, Converter={StaticResource InverseBooleanConverter}}"
                                                 GroupName="Theme"
                                                 Padding="12,8"
                                                 MinWidth="90"
                                                 Margin="8,0,0,0">
                                        <RadioButton.Style>
                                            <Style TargetType="RadioButton">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="RadioButton">
                                                            <Border x:Name="Border"
                                                                    Background="{DynamicResource PanelLightBrush}"
                                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="8"
                                                                    Padding="{TemplateBinding Padding}"
                                                                    Cursor="Hand">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="Border" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                                    <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource AccentContentBrush}" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </Trigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </RadioButton.Style>
                                    </RadioButton>
                                </StackPanel>
                                
                                <!-- Font Scale Slider -->
                                <TextBlock Text="Cỡ chữ" Style="{StaticResource SettingsFieldLabelStyle}" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    
                                    <Slider Grid.Column="0"
                                            Minimum="0.8"
                                            Maximum="1.3"
                                            TickFrequency="0.1"
                                            IsSnapToTickEnabled="True"
                                            Value="{Binding FontScale, Mode=TwoWay}"
                                            VerticalAlignment="Center"
                                            Margin="0,0,12,0" />
                                    
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding FontScale, StringFormat={}{0:P0}}"
                                               FontWeight="SemiBold"
                                               FontSize="11"
                                               MinWidth="45"
                                               TextAlignment="Right"
                                               VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="Kéo để điều chỉnh kích thước chữ trong ứng dụng"
                                           Style="{StaticResource SettingsFieldHintStyle}"
                                           Margin="0,0,0,0" />
                            </StackPanel>
                        </Border>

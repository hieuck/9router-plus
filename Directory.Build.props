<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
    <VersionPrefix>0.2.0</VersionPrefix>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <!-- Default test filter: exclude E2E tests unless explicitly overridden via filter -->
  <PropertyGroup>
    <VSTestTestCaseFilter Condition="'$(VSTestTestCaseFilter)' == ''">Category!=E2E</VSTestTestCaseFilter>
  </PropertyGroup>
  <!-- Analyzers only on product projects (src/). Test projects are excluded by location
       and by their IsTestProject=true convention to avoid disproportionate noise. -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.Contains('\src\')) And '$(IsTestProject)' != 'true'">
    <AnalysisMode>Recommended</AnalysisMode>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>
  <ItemGroup Condition="$(MSBuildProjectDirectory.Contains('\src\')) And '$(IsTestProject)' != 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" PrivateAssets="all" />
  </ItemGroup>
</Project>

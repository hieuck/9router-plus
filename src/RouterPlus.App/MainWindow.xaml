                                    <TextBlock Text="{Binding ConnectionStatusText}" FontSize="10" TextWrapping="Wrap" />
                                </Border>
                                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="38" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Activity log"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0" />
                        <Button Grid.Column="1"
                                Content="Sao chép log"
                                Click="CopyLog_Click"
                                Style="{StaticResource UtilityButtonStyle}"
                                VerticalAlignment="Center"
                                Margin="10,0,0,0" />
                        <TextBox Grid.Row="1"
                                 Grid.ColumnSpan="2"
                                 Text="{Binding LogText, Mode=OneWay}"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"
                                 Height="92"
                                 Margin="0,8,0,0" />
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <Border Grid.RowSpan="2"
                Grid.Column="1"
                Background="Transparent"
                Panel.ZIndex="10"
                Style="{StaticResource DrawerVisibilityStyle}" />
        <Border Grid.RowSpan="2"
                Grid.Column="1"
                Width="390"
                HorizontalAlignment="Right"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1,0,0,0"
                Padding="22"
                Panel.ZIndex="11"
                Style="{StaticResource DrawerVisibilityStyle}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <ToggleButton IsChecked="{Binding IsSettingsExpanded, Mode=TwoWay}"
                                  Style="{StaticResource UtilityToggleButtonStyle}"
                                  Margin="0,0,7,0">
                        <TextBlock Text="Xong"
                                   Foreground="{DynamicResource AccentContentBrush}"
                                   Margin="0" />
                    </ToggleButton>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,8">
                      <Button Content="Khôi phục cài đặt gốc"
                              Command="{Binding ResetSettingsCommand}"
                              Style="{StaticResource UtilityButtonStyle}"
                              Padding="12,8"
                              Margin="0,0,8,0"
                              ToolTip="Đặt lại tất cả cài đặt về giá trị mặc định" />
                      <Button Content="Lưu cài đặt"
                              Command="{Binding SaveSettingsCommand}"
                              Style="{StaticResource ProviderPrimaryActionButtonStyle}"
                              Margin="0" />
                  </StackPanel>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Cài đặt" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Giao diện, dashboard và Chrome" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,5,0,0" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1"
                                          IsChecked="{Binding IsSettingsExpanded, Mode=TwoWay}"
                                          Width="32"
                                          Height="32"
                                          Padding="0">
                                <TextBlock Text="×"
                                           Foreground="{DynamicResource AccentContentBrush}"
                                           Margin="0" />
                            </ToggleButton>
                        </Grid>
                        <Border Style="{StaticResource SettingsStatusStyle}">
                            <TextBlock Text="{Binding SettingsStatusText}"
                                       Style="{StaticResource SettingsStatusTextStyle}"
                                       TextWrapping="Wrap" />
                        </Border>

                        <!-- Improved Settings Section với icons và validation -->
                                                <Border Style="{StaticResource SettingsSectionStyle}">
                            <StackPanel>
                                <!-- Clickable Header -->
                                <Button Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        Margin="0,0,0,3"
                                        HorizontalContentAlignment="Stretch"
                                        Cursor="Hand"
                                        Command="{Binding ToggleAppearanceSectionCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <ContentPresenter />
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" 
                                                   FontFamily="Segoe UI Symbol"
                                                   FontSize="10"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"
                                                   Foreground="{DynamicResource TextBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="▼" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAppearanceSectionExpanded}" Value="False">
                                                            <Setter Property="Text" Value="▶" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="1" 
                                                   Text="Giao diện" 
                                                   Style="{StaticResource SettingsSectionTitleStyle}" 
                                                   Margin="0" />
                                    </Grid>
                                </Button>
                                
                                <!-- Collapsible Content -->
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAppearanceSectionExpanded}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    
                                    <TextBlock Text="Tùy chỉnh cách hiển thị của ứng dụng."
                                           Style="{StaticResource SettingsSectionDescriptionStyle}" />
                                
                                <!-- Theme Toggle Buttons -->
                                <TextBlock Text="Chủ đề" Style="{StaticResource SettingsFieldLabelStyle}" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <RadioButton Content="☀️ Sáng" 
                                                 IsChecked="{Binding UseLightTheme, Mode=TwoWay}"
                                                 GroupName="Theme"
                                                 Padding="12,8"
                                                 MinWidth="90">
                                        <RadioButton.Style>
                                            <Style TargetType="RadioButton">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="RadioButton">
                                                            <Border x:Name="Border"
                                                                    Background="{DynamicResource PanelLightBrush}"
                                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="8"
                                                                    Padding="{TemplateBinding Padding}"
                                                                    Cursor="Hand">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="Border" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                                    <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource AccentContentBrush}" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </Trigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </RadioButton.Style>
                                    </RadioButton>
                                    <RadioButton Content="🌙 Tối" 
                                                 IsChecked="{Binding UseLightTheme, Mode=TwoWay, Converter={StaticResource InverseBooleanConverter}}"
                                                 GroupName="Theme"
                                                 Padding="12,8"
                                                 MinWidth="90"
                                                 Margin="8,0,0,0">
                                        <RadioButton.Style>
                                            <Style TargetType="RadioButton">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="RadioButton">
                                                            <Border x:Name="Border"
                                                                    Background="{DynamicResource PanelLightBrush}"
                                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="8"
                                                                    Padding="{TemplateBinding Padding}"
                                                                    Cursor="Hand">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="Border" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                                    <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource AccentContentBrush}" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </Trigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </RadioButton.Style>
                                    </RadioButton>
                                </StackPanel>
                                
                                <!-- Font Scale Slider -->
                                <TextBlock Text="Cỡ chữ" Style="{StaticResource SettingsFieldLabelStyle}" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    
                                    <Slider Grid.Column="0"
                                            Minimum="0.8"
                                            Maximum="1.3"
                                            TickFrequency="0.1"
                                            IsSnapToTickEnabled="True"
                                            Value="{Binding FontScale, Mode=TwoWay}"
                                            VerticalAlignment="Center"
                                            Margin="0,0,12,0" />
                                    
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding FontScale, StringFormat={}{0:P0}}"
                                               FontWeight="SemiBold"
                                               FontSize="11"
                                               MinWidth="45"
                                               TextAlignment="Right"
                                               VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="Kéo để điều chỉnh kích thước chữ trong ứng dụng"
                                           Style="{StaticResource SettingsFieldHintStyle}"
                                           Margin="0,0,0,0" />
                            
                                </StackPanel>
                                </StackPanel>
                        </Border>


                        <Border Style="{StaticResource SettingsSectionStyle}">
                            <StackPanel>
                                <!-- Clickable Header -->
                                <Button Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        Margin="0,0,0,3"
                                        HorizontalContentAlignment="Stretch"
                                        Cursor="Hand"
                                        Command="{Binding ToggleDashboardSectionCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <ContentPresenter />
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" 
                                                   FontFamily="Segoe UI Symbol"
                                                   FontSize="10"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"
                                                   Foreground="{DynamicResource TextBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="▼" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDashboardSectionExpanded}" Value="False">
                                                            <Setter Property="Text" Value="▶" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="1" 
                                                   Text="Dashboard" 
                                                   Style="{StaticResource SettingsSectionTitleStyle}" 
                                                   Margin="0" />
                                    </Grid>
                                </Button>
                                
                                <!-- Collapsible Content -->
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDashboardSectionExpanded}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
<TextBlock Text="Địa chỉ 9Router mà ứng dụng sẽ mở."
                                           Style="{StaticResource SettingsSectionDescriptionStyle}" />
                                
                                <!-- Dashboard URL with validation indicator -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    
                                    <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                               Text="URL dashboard" 
                                               Style="{StaticResource SettingsFieldLabelStyle}" />
                                    
                                    <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                             Text="{Binding DashboardBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0" />
                                    
                                    <!-- Validation indicator -->
                                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" 
                                                Orientation="Horizontal" 
                                                Margin="0,4,0,0">
                                        <TextBlock FontSize="9" VerticalAlignment="Center" Margin="0,0,5,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="✓" />
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDashboardUrlValid}" Value="False">
                                                            <Setter Property="Text" Value="✗" />
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Margin="0"><TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsFieldHintStyle}">
                                                    <Setter Property="Text" Value="Ví dụ: http://localhost:20128" />
                                                    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDashboardUrlValid}" Value="False">
                                                            <Setter Property="Text" Value="URL không hợp lệ" />
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                                </StackPanel>

                            
                               </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsSectionStyle}">
                            <StackPanel>
                                <!-- Clickable Header with Auto-detect button -->
                                <Grid Margin="0,0,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="0"
                                            HorizontalContentAlignment="Left"
                                            VerticalContentAlignment="Center"
                                            Cursor="Hand"
                                            Command="{Binding ToggleChromeSectionCommand}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <ContentPresenter />
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock FontFamily="Segoe UI Symbol"
                                                       FontSize="10"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"
                                                       Foreground="{DynamicResource TextBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="▼" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsChromeSectionExpanded}" Value="False">
                                                                <Setter Property="Text" Value="▶" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="Chrome" 
                                                       Style="{StaticResource SettingsSectionTitleStyle}" 
                                                       Margin="0" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1"
                                            Content="⚡ Tự động phát hiện"
                                            Command="{Binding AutoDetectChromeCommand}"
                                            Style="{StaticResource UtilityButtonStyle}"
                                            FontSize="9"
                                            Padding="8,4"
                                            VerticalAlignment="Center"
                                            ToolTip="Tự động tìm Chrome installation" />
                                </Grid>
                                
                                <!-- Collapsible Content -->
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChromeSectionExpanded}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
<TextBlock Text="Đường dẫn dùng để đọc profile và mở dashboard đúng tài khoản."
                                           Style="{StaticResource SettingsSectionDescriptionStyle}" />
                                
                                <!-- Chrome Executable with validation -->
                                <TextBlock Text="Chrome executable" Style="{StaticResource SettingsFieldLabelStyle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    
                                    <TextBox Grid.Row="0" Grid.Column="0"
                                             Text="{Binding ChromeExecutablePath, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{Binding ChromeExecutablePath}"
                                             Margin="0" />
                                    <Button Grid.Row="0" Grid.Column="1"
                                            Content="Chọn file"
                                            Click="BrowseChrome_Click"
                                            Style="{StaticResource UtilityButtonStyle}"
                                            Margin="7,0,0,0" />
                                    
                                    <!-- Validation indicator -->
                                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                Orientation="Horizontal" 
                                                Margin="0,4,0,0">
                                        <TextBlock FontSize="9" VerticalAlignment="Center" Margin="0,0,5,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="✓" />
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsChromeExecutableValid}" Value="False">
                                                            <Setter Property="Text" Value="✗" />
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Margin="0"><TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsFieldHintStyle}">
                                                    <Setter Property="Text" Value="Đường dẫn hợp lệ" />
                                                    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsChromeExecutableValid}" Value="False">
                                                            <Setter Property="Text" Value="File không tồn tại" />
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                                
                                <!-- Chrome User Data with validation -->
                                <TextBlock Text="Chrome User Data" Style="{StaticResource SettingsFieldLabelStyle}" Margin="0,14,0,5" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    
                                    <TextBox Grid.Row="0" Grid.Column="0"
                                             Text="{Binding ChromeUserDataDirectory, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{Binding ChromeUserDataDirectory}"
                                             Margin="0" />
                                    <Button Grid.Row="0" Grid.Column="1"
                                            Content="Chọn thư mục"
                                            Click="BrowseUserData_Click"
                                            Style="{StaticResource UtilityButtonStyle}"
                                            Margin="7,0,0,0" />
                                    
                                    <!-- Validation indicator -->
                                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                Orientation="Horizontal" 
                                                Margin="0,4,0,0">
                                        <TextBlock FontSize="9" VerticalAlignment="Center" Margin="0,0,5,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="✓" />
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsChromeUserDataValid}" Value="False">
                                                            <Setter Property="Text" Value="✗" />
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Margin="0"><TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsFieldHintStyle}">
                                                    <Setter Property="Text" Value="Đường dẫn hợp lệ" />
                                                    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsChromeUserDataValid}" Value="False">
                                                            <Setter Property="Text" Value="Thư mục không tồn tại" />
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                                </StackPanel>

                            
                               </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>

















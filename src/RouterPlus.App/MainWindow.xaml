<Window x:Class="RouterPlus.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:RouterPlus.App"
        xmlns:core="clr-namespace:RouterPlus.Core.Providers;assembly=RouterPlus.Core"
        Title="9Router Profile Tool"
        Width="1440"
        Height="900"
        MinWidth="1040"
        MinHeight="720"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfaceBrush}"
        app:FontScaleBehavior.Scale="{Binding FontScale}"
        Loaded="Window_OnLoaded">
    <Window.Resources>
        <Style x:Key="SidebarTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsProfileSidebarCollapsed, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                             Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SidebarPanelStyle" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsProfileSidebarCollapsed, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                             Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SidebarGridStyle" TargetType="Grid">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsProfileSidebarCollapsed, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                             Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SidebarSearchStyle" TargetType="Border" BasedOn="{StaticResource InputBorderStyle}">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsProfileSidebarCollapsed, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                             Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BrandToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Grid.ColumnSpan" Value="1" />
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property='FocusVisualStyle' Value='{x:Null}' />
            <Setter Property='ToolTipService.IsEnabled' Value='False' />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsProfileSidebarCollapsed}" Value="True">
                    <Setter Property="Grid.ColumnSpan" Value="2" />
                    <Setter Property="HorizontalAlignment" Value="Center" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProfileAvatarStyle" TargetType="Border">
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="Grid.ColumnSpan" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsProfileSidebarCollapsed, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                             Value="True">
                    <Setter Property="Grid.Column" Value="0" />
                    <Setter Property="Grid.ColumnSpan" Value="4" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProfileListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource PanelLightBrush}" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PanelLightBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DrawerVisibilityStyle" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSettingsExpanded}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProviderWorkflowTagStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelLightBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition MinWidth="84">
                <ColumnDefinition.Style>
                    <Style TargetType="ColumnDefinition">
                        <Setter Property="Width" Value="320" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsProfileSidebarCollapsed}" Value="True">
                                <Setter Property="Width" Value="84" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ColumnDefinition.Style>
            </ColumnDefinition>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.RowSpan="2"
                Grid.Column="0"
                Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0"
                Padding="18,22,18,16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Style="{StaticResource SidebarPanelStyle}" Margin="4,16,4,0">
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" CornerRadius="10" Background="{DynamicResource AccentDarkBrush}">
                                <TextBlock Text="H" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="Chrome detected" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock Text="Last scan · ready" Style="{StaticResource SidebarTextStyle}" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>
                            <Ellipse Grid.Column="2" Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ToggleButton Style="{StaticResource BrandToggleButtonStyle}"
                                      IsChecked="{Binding IsProfileSidebarCollapsed, Mode=TwoWay}"
                                      ToolTip="Đóng hoặc mở danh sách profile">
                            <Grid Width="42" Height="42">
                                <Border Width="38" Height="38" CornerRadius="13" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="9R" Foreground="{DynamicResource SurfaceBrush}" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Border Width="17" Height="17" CornerRadius="9" Background="{DynamicResource AccentDarkBrush}" BorderBrush="{DynamicResource SidebarBrush}" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                    <Grid>
                                        <TextBlock Text="‹" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsProfileSidebarCollapsed}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="›" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsProfileSidebarCollapsed}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </Grid>
                        </ToggleButton>
                        <StackPanel Grid.Column="1" Margin="11,0,0,0" Style="{StaticResource SidebarPanelStyle}" VerticalAlignment="Center">
                            <TextBlock Text="9Router Profile Tool" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="Provider command center" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="1" Text="CHROME PROFILES" Style="{StaticResource SidebarTextStyle}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" Margin="4,0,0,10" />
                    <Grid Grid.Row="2" Style="{StaticResource SidebarGridStyle}" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="profiles" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding Profiles.Count, StringFormat={}{0} total}" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" />
                    </Grid>
                    <Border Grid.Row="3" Style="{StaticResource SidebarSearchStyle}"
                            Padding="10,0"
                            Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="⌕" FontSize="16" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding ProfileSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Tìm profile theo tên hoặc thư mục"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Padding="8,7"
                                     Margin="0"
                                     Foreground="{DynamicResource TextBrush}" />
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="4" x:Name="ProfileList"
                             ItemsSource="{Binding FilteredProfileRows}"
                             SelectedValue="{Binding SelectedProfile, Mode=TwoWay}"
                             SelectedValuePath="Profile"
                             AlternationCount="2147483647"
                             ItemContainerStyle="{StaticResource ProfileListItemStyle}"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.CanContentScroll="True"
                             MouseDoubleClick="ProfileList_OnMouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource OneBasedIndexConverter}}"
                                               Style="{StaticResource SidebarTextStyle}"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="10"
                                               VerticalAlignment="Center"
                                               TextAlignment="Right" />
                                    <Border Style="{StaticResource ProfileAvatarStyle}"
                                            Width="32"
                                            Height="32"
                                            CornerRadius="11"
                                            Background="{DynamicResource AccentDarkBrush}">
                                        <TextBlock Text="{Binding Initial}" Foreground="{DynamicResource TextBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="2" Margin="10,0,5,0" Style="{StaticResource SidebarPanelStyle}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding ConnectionSummary}" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
                                        <ItemsControl ItemsSource="{Binding ProviderStatuses}" Margin="0,4,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Ellipse Width="6" Height="6" Margin="0,0,4,0" ToolTip="{Binding ToolTip}">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="{DynamicResource BorderBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                                        <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                                                        <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsKnown}" Value="False">
                                                                        <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                            <TextBlock Grid.Column="3" Text="›" Style="{StaticResource SidebarTextStyle}" Foreground="{DynamicResource MutedTextBrush}" FontSize="16" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </DockPanel>
        </Border>

        <Grid Grid.Row="0" Grid.Column="1" Margin="26,22,26,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="9Router  /  Profile workspace" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                <TextBlock Text="Manage providers by Chrome profile" FontSize="20" FontWeight="SemiBold" Margin="0,7,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="↻  Đồng bộ" Command="{Binding RefreshConnectionStatusesCommand}" />
                <ToggleButton Content="⚙  Cài đặt" IsChecked="{Binding IsSettingsExpanded, Mode=TwoWay}" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      Grid.Column="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      CanContentScroll="False">
            <Grid Margin="26,0,26,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource HeroBorderStyle}" Padding="24" Margin="0,0,0,22">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="58" Height="58" CornerRadius="18" Background="{DynamicResource AccentDarkBrush}" VerticalAlignment="Top">
                            <TextBlock Text="{Binding SelectedProfileRow.Initial, TargetNullValue=?}" Foreground="{DynamicResource TextBrush}" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="15,0,20,0">
                            <TextBlock Text="SELECTED CHROME PROFILE" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" FontWeight="Bold" />
                            <TextBlock Text="{Binding SelectedProfile.Name, TargetNullValue=Chưa chọn profile}" FontSize="30" FontWeight="SemiBold" Margin="0,7,0,0" />
                            <TextBlock Text="{Binding SelectedProfile.ProfilePath, TargetNullValue=Chọn profile để xem đường dẫn}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Border Style="{StaticResource SuccessPillStyle}">
                                    <TextBlock Text="● Chrome sẵn sàng" FontSize="10" />
                                </Border>
                                <Border Style="{StaticResource InfoPillStyle}" Margin="7,0,0,0">
                                    <TextBlock Text="{Binding SelectedProfileRow.ConnectionSummary, TargetNullValue=Chưa đồng bộ}" FontSize="10" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Content="↗  Mở dashboard" Command="{Binding LaunchSelectedCommand}" />
                            <Button Content="↻  Làm mới" Command="{Binding RefreshCommand}" />
                        </StackPanel>
                        <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,24,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource StatBorderStyle}" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="Provider connected" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" />
                                    <TextBlock Text="{Binding SelectedProfileRow.ConnectedProviderCount, TargetNullValue=0, StringFormat={}{0} / 5}" FontSize="16" FontWeight="Bold" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource StatBorderStyle}" Margin="3,0">
                                <StackPanel>
                                    <TextBlock Text="Provider status" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" />
                                    <TextBlock Text="{Binding ConnectionStatusText}" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource StatBorderStyle}" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Dashboard" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" />
                                    <TextBlock Text="{Binding DashboardBaseUrl}" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="280" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,18,0">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Provider workspace" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="Thêm hoặc kiểm tra connection theo profile đang chọn." Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                            </StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource InfoPillStyle}" VerticalAlignment="Center">
                                <TextBlock Text="5 providers" FontSize="10" />
                            </Border>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding ProviderCards}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel IsItemsHost="True" ItemWidth="360" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,10,10">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="34" Height="34" CornerRadius="11" Background="{DynamicResource AccentDarkBrush}">
                                                    <TextBlock Text="{Binding ShortCode}" Foreground="{DynamicResource TextBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="10,0,8,0">
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Workflow}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" />
                                                </StackPanel>
                                                <Border Grid.Column="2" Style="{StaticResource ProviderWorkflowTagStyle}">
                                                    <TextBlock Text="{Binding Workflow}" Foreground="{DynamicResource MutedTextBrush}" FontSize="9" />
                                                </Border>
                                            </Grid>
                                                <TextBlock Text="API key cho profile đang chọn" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,14,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Workflow}" Value="{x:Static core:WorkflowKind.ApiKey}">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Grid Margin="0,8,0,0">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Workflow}" Value="{x:Static core:WorkflowKind.ApiKey}">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <PasswordBox app:PasswordBoxHelper.BindPassword="True"
                                                             app:PasswordBoxHelper.BoundPassword="{Binding ApiKeyValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             ToolTip="Dán API key tại đây">
                                                    <PasswordBox.Style>
                                                        <Style TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsApiKeyVisible}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </PasswordBox.Style>
                                                </PasswordBox>
                                                <TextBox Text="{Binding ApiKeyValue, UpdateSourceTrigger=PropertyChanged}" ToolTip="API key đang hiển thị">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsApiKeyVisible}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>
                                                <Button Grid.Column="1"
                                                        Content="Paste"
                                                        Click="PasteProviderApiKey_Click"
                                                        Padding="9,6"
                                                        Margin="7,0,0,0"
                                                        ToolTip="Paste API key from clipboard" />
                                            </Grid>
                                            <Grid Margin="0,8,0,0">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Workflow}" Value="{x:Static core:WorkflowKind.ApiKey}">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding ApiKeyStatusText}" Foreground="{DynamicResource SuccessBrush}" FontSize="10" />
                                                <TextBlock Grid.Column="1" Text="DPAPI" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" />
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                                <Button Content="{Binding ApiKeyToggleText}"
                                                        Click="ToggleProviderApiKeyVisibility_Click"
                                                        Padding="9,6"
                                                        HorizontalAlignment="Left">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Workflow}" Value="{x:Static core:WorkflowKind.ApiKey}">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Content="Thêm vào 9Router"
                                                        Click="AddProviderApiKey_Click"
                                                        Padding="12,7"
                                                        Margin="7,0,0,0">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Workflow}" Value="{x:Static core:WorkflowKind.ApiKey}">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Content="Mở trang lấy key"
                                                        Command="{Binding DataContext.OpenQuickLinkCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                        CommandParameter="{Binding Kind}"
                                                        Padding="9,6"
                                                        Margin="7,0,0,0">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Workflow}" Value="{x:Static core:WorkflowKind.ApiKey}">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Workflow}" Value="{x:Static core:WorkflowKind.OAuth}">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Workflow}" Value="{x:Static core:WorkflowKind.DeviceCode}">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <Button Content="Thêm"
                                                        Command="{Binding DataContext.OpenProviderCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                        CommandParameter="{Binding Kind}"
                                                        Style="{StaticResource PrimaryButtonStyle}" />
                                                <Button Content="Mở nhanh"
                                                        Command="{Binding DataContext.OpenQuickLinkCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                        CommandParameter="{Binding Kind}"
                                                        Margin="7,0,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <Border Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Profile snapshot" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="Thông tin nhanh cho profile đang chọn." Foreground="{DynamicResource MutedTextBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,10" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Chrome directory" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" />
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedProfile.DirectoryName, TargetNullValue=—}" FontSize="10" FontWeight="SemiBold" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Dashboard" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" />
                                    <TextBlock Grid.Column="1" Text="{Binding DashboardBaseUrl}" FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Connection match" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" />
                                    <TextBlock Grid.Column="1" Text="By profile name" FontSize="10" FontWeight="SemiBold" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Secret storage" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" />
                                    <TextBlock Grid.Column="1" Text="Windows DPAPI" FontSize="10" FontWeight="SemiBold" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Current activity" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="Status và log gần nhất." Foreground="{DynamicResource MutedTextBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,10" />
                                <Border Style="{StaticResource InfoPillStyle}" HorizontalAlignment="Left" Margin="0,0,0,10">
                                    <TextBlock Text="{Binding ConnectionStatusText}" FontSize="10" TextWrapping="Wrap" />
                                </Border>
                                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="14">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Sao chép log" Click="CopyLog_Click" Margin="10,0,0,0" />
                        <StackPanel>
                            <TextBlock Text="Activity log" FontSize="12" FontWeight="SemiBold" />
                            <TextBox Text="{Binding LogText, Mode=OneWay}"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Disabled"
                                     Height="92"
                                     Margin="0,8,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <Border Grid.RowSpan="2"
                Grid.Column="1"
                Background="#66000000"
                Panel.ZIndex="10"
                Style="{StaticResource DrawerVisibilityStyle}" />
        <Border Grid.RowSpan="2"
                Grid.Column="1"
                Width="390"
                HorizontalAlignment="Right"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1,0,0,0"
                Padding="22"
                Panel.ZIndex="11"
                Style="{StaticResource DrawerVisibilityStyle}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button Content="Lưu cài đặt" Command="{Binding SaveSettingsCommand}" />
                    <ToggleButton Content="Xong" IsChecked="{Binding IsSettingsExpanded, Mode=TwoWay}" Margin="7,0,0,0" />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Cài đặt" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Dashboard và Chrome paths" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,5,0,0" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Content="×" IsChecked="{Binding IsSettingsExpanded, Mode=TwoWay}" Width="32" Height="32" Padding="0" />
                        </Grid>
                        <TextBlock Text="Theme" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" />
                        <ComboBox ItemsSource="{Binding ThemeOptions}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding UseLightTheme, Mode=TwoWay}"
                                  Margin="0,5,0,14" />
                        <TextBlock Text="Font size" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" />
                        <ComboBox ItemsSource="{Binding FontScaleOptions}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding FontScale, Mode=TwoWay}"
                                  Margin="0,5,0,14" />
                        <TextBlock Text="Dashboard URL" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" />
                        <TextBox Text="{Binding DashboardBaseUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,14" />
                        <TextBlock Text="Chrome executable" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" />
                        <Grid Margin="0,5,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding ChromeExecutablePath, UpdateSourceTrigger=PropertyChanged}" Margin="0" />
                            <Button Grid.Column="1" Content="Chọn file" Click="BrowseChrome_Click" Margin="7,0,0,0" />
                        </Grid>
                        <TextBlock Text="Chrome User Data" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" />
                        <Grid Margin="0,5,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding ChromeUserDataDirectory, UpdateSourceTrigger=PropertyChanged}" Margin="0" />
                            <Button Grid.Column="1" Content="Chọn thư mục" Click="BrowseUserData_Click" Margin="7,0,0,0" />
                        </Grid>
                        <Border Style="{StaticResource InfoPanelStyle}" Padding="13" Margin="0,8,0,0">
                            <TextBlock Text="Cài đặt được dùng để đọc profile và mở dashboard bằng đúng Chrome profile."
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="10"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>

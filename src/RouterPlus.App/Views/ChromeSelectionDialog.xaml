<Window x:Class="RouterPlus.App.Views.ChromeSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chon Chrome Installation"
        Width="600" Height="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource SurfaceBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Chon Chrome" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Quet lai" Click="Rescan_Click" Padding="10,4" VerticalAlignment="Center" />
        </Grid>

        <!-- List -->
        <ListBox Grid.Row="1"
                 x:Name="InstallationListBox"
                 ItemsSource="{Binding Installations}"
                 SelectedItem="{Binding SelectedInstallation, Mode=TwoWay}"
                 BorderBrush="{DynamicResource BorderBrush}"
                 BorderThickness="1"
                 Background="{DynamicResource PanelBrush}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6"
                                Background="{DynamicResource AccentDarkBrush}" Margin="0,0,10,0">
                            <TextBlock Text="C" Foreground="{DynamicResource AvatarTextBrush}"
                                       FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding ExecutablePath}" FontSize="9"
                                       Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding UserDataDirectory}" FontSize="9"
                                       Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                            <Button Content="Chrome" FontSize="9" Padding="6,2" Margin="0,0,4,0"
                                    ToolTip="Mo vi tri Chrome"
                                    Click="OpenChromeLocation_Click"
                                    Tag="{Binding ExecutablePath}" />
                            <Button Content="Data" FontSize="9" Padding="6,2"
                                    ToolTip="Mo vi tri User Data"
                                    Click="OpenUserDataLocation_Click"
                                    Tag="{Binding UserDataDirectory}" />
                            <Border Margin="6,0,0,0" CornerRadius="4" Padding="5,1"
                                    Background="{DynamicResource SuccessBrush}"
                                    Visibility="{Binding IsValid, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="OK" FontSize="9" Foreground="White" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Huy" Width="80" Height="32" Margin="0,0,8,0" Click="Cancel_Click" />
            <Button x:Name="SelectButton" Content="Chon" Width="80" Height="32" Click="Select_Click" IsEnabled="False"
                    Style="{StaticResource PrimaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>

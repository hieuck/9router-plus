<Window x:Class="RouterPlus.App.Views.CredentialsManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🔐 Credentials Manager"
        Width="700" Height="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinWidth="600" MinHeight="500"
        Background="{DynamicResource SurfaceBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TabControl -->
        <TabControl Grid.Row="0" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
            <!-- Google Accounts Tab -->
            <TabItem Header="Google">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Manage Google accounts for OAuth authentication"
                               FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,12" />

                    <ListView Grid.Row="1" ItemsSource="{Binding GoogleAccounts}"
                              SelectedItem="{Binding SelectedGoogleAccount, Mode=TwoWay}"
                              Margin="0,0,0,12">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Email" Width="350" DisplayMemberBinding="{Binding Email}" />
                                <GridViewColumn Header="TOTP" Width="80" DisplayMemberBinding="{Binding TotpIndicator}" />
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Button Content="➕ Add" Style="{StaticResource DialogButtonStyle}"
                                Click="AddGoogleAccount_Click" Margin="0,0,8,0" />
                        <Button Content="✏️ Edit" Style="{StaticResource DialogButtonStyle}"
                                Click="EditGoogleAccount_Click"
                                IsEnabled="{Binding SelectedGoogleAccount, Converter={StaticResource NullToFalseConverter}}"
                                Margin="0,0,8,0" />
                        <Button Content="🗑️ Remove" Style="{StaticResource DialogButtonStyle}"
                                Click="RemoveGoogleAccount_Click"
                                IsEnabled="{Binding SelectedGoogleAccount, Converter={StaticResource NullToFalseConverter}}"
                                Margin="0" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Codex Tab -->
            <TabItem Header="Codex (OpenAI)">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Manage Codex (OpenAI) authentication for each profile"
                               FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,12" />

                    <ListView Grid.Row="1" ItemsSource="{Binding CodexConnections}"
                              SelectedItem="{Binding SelectedCodexConnection, Mode=TwoWay}"
                              Margin="0,0,0,12">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Profile" Width="200" DisplayMemberBinding="{Binding ProfileName}" />
                                <GridViewColumn Header="Method" Width="150" DisplayMemberBinding="{Binding PreferredMethodText}" />
                                <GridViewColumn Header="Google Account" Width="200" DisplayMemberBinding="{Binding LinkedGoogleAccount}" />
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Button Content="⚙️ Configure" Style="{StaticResource DialogButtonStyle}"
                                Click="ConfigureCodexConnection_Click"
                                IsEnabled="{Binding SelectedCodexConnection, Converter={StaticResource NullToFalseConverter}}"
                                Margin="0" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Kiro Tab -->
            <TabItem Header="Kiro (AWS)">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Manage Kiro (AWS Builder ID) authentication for each profile"
                               FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,12" />

                    <ListView Grid.Row="1" ItemsSource="{Binding KiroConnections}"
                              SelectedItem="{Binding SelectedKiroConnection, Mode=TwoWay}"
                              Margin="0,0,0,12">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Profile" Width="200" DisplayMemberBinding="{Binding ProfileName}" />
                                <GridViewColumn Header="Method" Width="150" DisplayMemberBinding="{Binding PreferredMethodText}" />
                                <GridViewColumn Header="Google Account" Width="200" DisplayMemberBinding="{Binding LinkedGoogleAccount}" />
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Button Content="⚙️ Configure" Style="{StaticResource DialogButtonStyle}"
                                Click="ConfigureKiroConnection_Click"
                                IsEnabled="{Binding SelectedKiroConnection, Converter={StaticResource NullToFalseConverter}}"
                                Margin="0" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- GitHub Tab -->
            <TabItem Header="GitHub">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Manage GitHub authentication for each profile"
                               FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,12" />

                    <ListView Grid.Row="1" ItemsSource="{Binding GitHubConnections}"
                              SelectedItem="{Binding SelectedGitHubConnection, Mode=TwoWay}"
                              Margin="0,0,0,12">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Profile" Width="200" DisplayMemberBinding="{Binding ProfileName}" />
                                <GridViewColumn Header="Method" Width="150" DisplayMemberBinding="{Binding PreferredMethodText}" />
                                <GridViewColumn Header="Google Account" Width="200" DisplayMemberBinding="{Binding LinkedGoogleAccount}" />
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Button Content="⚙️ Configure" Style="{StaticResource DialogButtonStyle}"
                                Click="ConfigureGitHubConnection_Click"
                                IsEnabled="{Binding SelectedGitHubConnection, Converter={StaticResource NullToFalseConverter}}"
                                Margin="0" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- OpenRouter Tab -->
            <TabItem Header="OpenRouter">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Manage OpenRouter authentication for each profile"
                               FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,12" />

                    <ListView Grid.Row="1" ItemsSource="{Binding OpenRouterConnections}"
                              SelectedItem="{Binding SelectedOpenRouterConnection, Mode=TwoWay}"
                              Margin="0,0,0,12">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Profile" Width="200" DisplayMemberBinding="{Binding ProfileName}" />
                                <GridViewColumn Header="Method" Width="150" DisplayMemberBinding="{Binding PreferredMethodText}" />
                                <GridViewColumn Header="Google Account" Width="200" DisplayMemberBinding="{Binding LinkedGoogleAccount}" />
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Button Content="⚙️ Configure" Style="{StaticResource DialogButtonStyle}"
                                Click="ConfigureOpenRouterConnection_Click"
                                IsEnabled="{Binding SelectedOpenRouterConnection, Converter={StaticResource NullToFalseConverter}}"
                                Margin="0" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                Background="{DynamicResource PanelBrush}" CornerRadius="8" Padding="8" Margin="0,12,0,12">
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="10" />
        </Border>

        <!-- Close Button -->
        <Button Grid.Row="2" Content="Close" Style="{StaticResource DialogButtonStyle}"
                Click="Close_Click" HorizontalAlignment="Right" />
    </Grid>
</Window>

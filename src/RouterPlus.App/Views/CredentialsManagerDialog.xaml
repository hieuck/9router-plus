<Window x:Class="RouterPlus.App.Views.CredentialsManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:RouterPlus.App"
        xmlns:converters="clr-namespace:RouterPlus.App.Converters"
        Title="🔐 Credentials Manager"
        Width="1000" Height="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinWidth="950" MinHeight="500"
        Background="{DynamicResource SurfaceBrush}">
    <Window.Resources>
        <converters:NullToFalseConverter x:Key="NullToFalseConverter" />
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="CredentialsListItemStyle" TargetType="{x:Type ListViewItem}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TabControl -->
        <TabControl Grid.Row="0" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
            <!-- Google Accounts Tab -->
            <TabItem AutomationProperties.AutomationId="GoogleAccountsTab" Header="Google">
                <Grid Margin="12" Grid.IsSharedSizeScope="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Manage Google accounts for OAuth authentication. Check profiles to batch login."
                               FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,12" />

                    <Grid Grid.Row="1" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" SharedSizeGroup="CredentialsSelect" />
                            <ColumnDefinition Width="140" SharedSizeGroup="CredentialsProfile" />
                            <ColumnDefinition Width="240" SharedSizeGroup="CredentialsEmail" />
                            <ColumnDefinition Width="140" SharedSizeGroup="CredentialsPassword" />
                            <ColumnDefinition Width="120" SharedSizeGroup="CredentialsTotp" />
                            <ColumnDefinition Width="70" SharedSizeGroup="CredentialsEdit" />
                            <ColumnDefinition Width="70" SharedSizeGroup="CredentialsLogin" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="Profile" FontWeight="SemiBold" Margin="4,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="Email" FontWeight="SemiBold" Margin="4,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="Password" FontWeight="SemiBold" Margin="4,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="TOTP Secret" FontWeight="SemiBold" Margin="4,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="5" Text="Edit" FontWeight="SemiBold" Margin="4,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="6" Text="Login" FontWeight="SemiBold" Margin="4,0" VerticalAlignment="Center" />
                    </Grid>

                    <ListView AutomationProperties.AutomationId="GoogleAccountsList"
                              Grid.Row="2" ItemsSource="{Binding GoogleAccounts}"
                              SelectedItem="{Binding SelectedGoogleAccount, Mode=TwoWay}"
                              ItemContainerStyle="{StaticResource CredentialsListItemStyle}"
                              IsEnabled="{Binding CanModifyCredentials}"
                              Margin="0,0,0,12"
                              SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" SharedSizeGroup="CredentialsSelect" />
                                        <ColumnDefinition Width="140" SharedSizeGroup="CredentialsProfile" />
                                        <ColumnDefinition Width="240" SharedSizeGroup="CredentialsEmail" />
                                        <ColumnDefinition Width="140" SharedSizeGroup="CredentialsPassword" />
                                        <ColumnDefinition Width="120" SharedSizeGroup="CredentialsTotp" />
                                        <ColumnDefinition Width="70" SharedSizeGroup="CredentialsEdit" />
                                        <ColumnDefinition Width="70" SharedSizeGroup="CredentialsLogin" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Selection Checkbox -->
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              IsEnabled="{Binding HasCredentials}"
                                              VerticalAlignment="Center" />

                                    <!-- Profile Name (Read-only) -->
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding ProfileName}"
                                               VerticalAlignment="Center"
                                               Margin="4,0" />

                                    <!-- Email (Editable) -->
                                    <TextBox AutomationProperties.AutomationId="GoogleEmailEditor"
                                             Grid.Column="2"
                                             Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                             IsReadOnly="{Binding IsEditable, Converter={StaticResource InverseBooleanConverter}}"
                                             VerticalAlignment="Center"
                                             Height="28"
                                             Padding="6,4"
                                             Margin="4,0" />

                                    <!-- Password (Editable with inline visibility toggle) -->
                                    <Grid Grid.Column="3">
                                        <PasswordBox AutomationProperties.AutomationId="GooglePasswordEditor"
                                                     app:PasswordBoxHelper.BindPassword="True"
                                                     app:PasswordBoxHelper.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEnabled="{Binding IsEditable}"
                                                     Visibility="{Binding IsPasswordVisible, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                                     VerticalAlignment="Center"
                                                     Height="28"
                                                     Padding="6,4,32,4"
                                                     Margin="4,0" />
                                        <TextBox AutomationProperties.AutomationId="GooglePasswordVisibleEditor"
                                                 Text="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 IsReadOnly="{Binding IsEditable, Converter={StaticResource InverseBooleanConverter}}"
                                                 Visibility="{Binding IsPasswordVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                 VerticalAlignment="Center"
                                                 Height="28"
                                                 Padding="6,4,32,4"
                                                 Margin="4,0" />
                                        <Button AutomationProperties.AutomationId="GooglePasswordVisibilityButton"
                                                Panel.ZIndex="1"
                                                Content="{Binding PasswordVisibilityButtonText}"
                                                ToolTip="{Binding PasswordVisibilityToolTip}"
                                                Click="TogglePasswordVisibility_Click"
                                                IsEnabled="{Binding IsEditable}"
                                                FontSize="9"
                                                Padding="2,1"
                                                Width="26"
                                                Height="22"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Margin="0,0,6,0" />
                                    </Grid>

                                    <!-- TOTP Secret (Editable with inline visibility toggle) -->
                                    <Grid Grid.Column="4">
                                        <PasswordBox AutomationProperties.AutomationId="GoogleTotpEditor"
                                                     app:PasswordBoxHelper.BindPassword="True"
                                                     app:PasswordBoxHelper.BoundPassword="{Binding TotpSecret, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEnabled="{Binding IsEditable}"
                                                     Visibility="{Binding IsTotpSecretVisible, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                                     VerticalAlignment="Center"
                                                     Height="28"
                                                     Padding="6,4,32,4"
                                                     Margin="4,0"
                                                     ToolTip="TOTP Secret (optional)" />
                                        <TextBox AutomationProperties.AutomationId="GoogleTotpVisibleEditor"
                                                 Text="{Binding TotpSecret, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 IsReadOnly="{Binding IsEditable, Converter={StaticResource InverseBooleanConverter}}"
                                                 Visibility="{Binding IsTotpSecretVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                 VerticalAlignment="Center"
                                                 Height="28"
                                                 Padding="6,4,32,4"
                                                 Margin="4,0"
                                                     ToolTip="TOTP Secret (optional)" />
                                        <Button AutomationProperties.AutomationId="GoogleTotpVisibilityButton"
                                                Panel.ZIndex="1"
                                                Content="{Binding TotpVisibilityButtonText}"
                                                ToolTip="{Binding TotpVisibilityToolTip}"
                                                Click="ToggleTotpVisibility_Click"
                                                IsEnabled="{Binding IsEditable}"
                                                FontSize="9"
                                                Padding="2,1"
                                                Width="26"
                                                Height="22"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Margin="0,0,6,0" />
                                    </Grid>

                                    <!-- Edit/Save Button -->
                                    <Button Grid.Column="5"
                                            Content="{Binding ActionButtonText}"
                                            Command="{Binding DataContext.SaveRowCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}"
                                            Padding="8,4"
                                            Margin="4,0" />

                                    <!-- Single-profile Login Button -->
                                    <Button AutomationProperties.AutomationId="GoogleLoginRowButton"
                                            Grid.Column="6"
                                            Content="🚀"
                                            ToolTip="Login this profile"
                                            Command="{Binding DataContext.LoginRowCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding HasCredentials}"
                                            Padding="8,4"
                                            Margin="4,0" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel Grid.Row="3" Orientation="Horizontal">
                        <Button AutomationProperties.AutomationId="BatchLoginButton"
                                Content="🚀 Batch Login"
                                Style="{StaticResource DialogButtonStyle}"
                                Command="{Binding BatchLoginCommand}"
                                Margin="0,0,8,0">
                            <Button.ToolTip>
                                <TextBlock>
                                    <Run Text="Login selected profiles (" />
                                    <Run Text="{Binding SelectedCount, Mode=OneWay}" />
                                    <Run Text=" selected)" />
                                </TextBlock>
                            </Button.ToolTip>
                        </Button>
                        <Button AutomationProperties.AutomationId="RemoveGoogleAccountButton"
                                Content="🗑️ Remove" Style="{StaticResource DialogButtonStyle}"
                                Click="RemoveGoogleAccount_Click"
                                IsEnabled="{Binding CanRemoveGoogleAccount}"
                                Margin="0" />
                        <Button AutomationProperties.AutomationId="StopBatchLoginButton"
                                Content="⏹ Stop Batch Login"
                                Style="{StaticResource DialogButtonStyle}"
                                Command="{Binding StopBatchLoginCommand}"
                                Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Codex Tab with Inline Editing -->
            <TabItem AutomationProperties.AutomationId="CodexTab" Header="Codex (OpenAI)">
                <Grid Margin="12" Grid.IsSharedSizeScope="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Manage Codex (OpenAI) authentication. Choose Google OAuth (use saved Google account) or Direct Login (email+password)."
                               FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,12" />

                    <Grid Grid.Row="1" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" SharedSizeGroup="CodexSelect" />
                            <ColumnDefinition Width="120" SharedSizeGroup="CodexProfile" />
                            <ColumnDefinition Width="85" SharedSizeGroup="CodexMethod" />
                            <ColumnDefinition Width="200" SharedSizeGroup="CodexGoogleOrEmail" />
                            <ColumnDefinition Width="120" SharedSizeGroup="CodexPassword" />
                            <ColumnDefinition Width="100" SharedSizeGroup="CodexTotp" />
                            <ColumnDefinition Width="80" SharedSizeGroup="CodexEdit" />
                            <ColumnDefinition Width="60" SharedSizeGroup="CodexLogin" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="Profile" FontWeight="SemiBold" Margin="4,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="Method" FontWeight="SemiBold" Margin="4,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="Google / Email" FontWeight="SemiBold" Margin="4,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="Password" FontWeight="SemiBold" Margin="4,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="5" Text="TOTP" FontWeight="SemiBold" Margin="4,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="6" Text="Edit" FontWeight="SemiBold" Margin="4,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="7" Text="Login" FontWeight="SemiBold" Margin="4,0" VerticalAlignment="Center" />
                    </Grid>

                    <ListView AutomationProperties.AutomationId="CodexConnectionsList"
                              Grid.Row="2" ItemsSource="{Binding CodexConnections}"
                              SelectedItem="{Binding SelectedCodexConnection, Mode=TwoWay}"
                              ItemContainerStyle="{StaticResource CredentialsListItemStyle}"
                              IsEnabled="{Binding CanModifyCredentials}"
                              Margin="0,0,0,12"
                              SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" SharedSizeGroup="CodexSelect" />
                                        <ColumnDefinition Width="120" SharedSizeGroup="CodexProfile" />
                                        <ColumnDefinition Width="85" SharedSizeGroup="CodexMethod" />
                                        <ColumnDefinition Width="200" SharedSizeGroup="CodexGoogleOrEmail" />
                                        <ColumnDefinition Width="120" SharedSizeGroup="CodexPassword" />
                                        <ColumnDefinition Width="100" SharedSizeGroup="CodexTotp" />
                                        <ColumnDefinition Width="80" SharedSizeGroup="CodexEdit" />
                                        <ColumnDefinition Width="60" SharedSizeGroup="CodexLogin" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Selection Checkbox -->
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              IsEnabled="{Binding HasCredentials}"
                                              VerticalAlignment="Center" />

                                    <!-- Profile Name -->
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding ProfileName}"
                                               VerticalAlignment="Center"
                                               Margin="4,0" />

                                    <!-- Auth Method Display (when not editing) -->
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding AuthMethodDisplay}"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding IsEditable, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                               Margin="4,0" />

                                    <!-- Auth Method Dropdown (when editing) -->
                                    <ComboBox Grid.Column="2"
                                              SelectedIndex="{Binding AuthMethod, Mode=TwoWay}"
                                              Visibility="{Binding IsEditable, Converter={StaticResource BooleanToVisibilityConverter}}"
                                              VerticalAlignment="Center"
                                              Height="28"
                                              Margin="4,0">
                                        <ComboBoxItem Content="Google" />
                                        <ComboBoxItem Content="Direct" />
                                    </ComboBox>

                                    <!-- Column 3: Google Account Display (when not editing) -->
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding LinkedGoogleAccount}"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding IsGoogleOAuth, Converter={StaticResource BooleanToVisibilityConverter}}"
                                               Margin="4,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditable}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- Column 3: Google Account ComboBox (when editing) -->
                                    <ComboBox Grid.Column="3"
                                              ItemsSource="{Binding SuggestedGoogleAccounts}"
                                              DisplayMemberPath="DisplayText"
                                              SelectedValue="{Binding LinkedGoogleAccount, Mode=TwoWay}"
                                              SelectedValuePath="Email"
                                              Visibility="{Binding IsGoogleOAuth, Converter={StaticResource BooleanToVisibilityConverter}}"
                                              VerticalAlignment="Center"
                                              Height="28"
                                              Margin="4,0">
                                        <ComboBox.ItemContainerStyle>
                                            <Style TargetType="ComboBoxItem">
                                                <Setter Property="IsEnabled" Value="{Binding IsSeparator, Converter={StaticResource InverseBooleanConverter}}" />
                                            </Style>
                                        </ComboBox.ItemContainerStyle>
                                        <ComboBox.Style>
                                            <Style TargetType="ComboBox">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditable}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ComboBox.Style>
                                    </ComboBox>

                                    <!-- Column 3: Email Display (when not editing Direct mode) -->
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding Email}"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding IsDirect, Converter={StaticResource BooleanToVisibilityConverter}}"
                                               Margin="4,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditable}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- Column 3: Email TextBox (when editing Direct mode) -->
                                    <TextBox Grid.Column="3"
                                             Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                             Visibility="{Binding IsDirect, Converter={StaticResource BooleanToVisibilityConverter}}"
                                             VerticalAlignment="Center"
                                             Height="28"
                                             Padding="6,4"
                                             Margin="4,0">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditable}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>

                                    <!-- Password (Direct only) -->
                                    <Grid Grid.Column="4">
                                        <PasswordBox app:PasswordBoxHelper.BindPassword="True"
                                                     app:PasswordBoxHelper.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEnabled="{Binding IsDirect}"
                                                     Visibility="{Binding IsPasswordVisible, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                                     VerticalAlignment="Center"
                                                     Height="28"
                                                     Padding="6,4,32,4"
                                                     Margin="4,0" />
                                        <TextBox Text="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 IsReadOnly="{Binding IsEditable, Converter={StaticResource InverseBooleanConverter}}"
                                                 Visibility="{Binding IsPasswordVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                 VerticalAlignment="Center"
                                                 Height="28"
                                                 Padding="6,4,32,4"
                                                 Margin="4,0" />
                                        <Button Panel.ZIndex="1"
                                                Content="{Binding PasswordVisibilityButtonText}"
                                                ToolTip="{Binding PasswordVisibilityToolTip}"
                                                Click="ToggleCodexPasswordVisibility_Click"
                                                IsEnabled="{Binding IsDirect}"
                                                FontSize="9"
                                                Padding="2,1"
                                                Width="26"
                                                Height="22"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Margin="0,0,6,0" />
                                    </Grid>

                                    <!-- TOTP (Always enabled - can be used for both Direct and OAuth) -->
                                    <Grid Grid.Column="5">
                                        <PasswordBox app:PasswordBoxHelper.BindPassword="True"
                                                     app:PasswordBoxHelper.BoundPassword="{Binding TotpSecret, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Visibility="{Binding IsTotpSecretVisible, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                                     VerticalAlignment="Center"
                                                     Height="28"
                                                     Padding="6,4,32,4"
                                                     Margin="4,0"
                                                     ToolTip="Codex TOTP Secret (optional - for Codex 2FA after OAuth)" />
                                        <TextBox Text="{Binding TotpSecret, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 IsReadOnly="{Binding IsEditable, Converter={StaticResource InverseBooleanConverter}}"
                                                 Visibility="{Binding IsTotpSecretVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                 VerticalAlignment="Center"
                                                 Height="28"
                                                 Padding="6,4,32,4"
                                                 Margin="4,0"
                                                 ToolTip="Codex TOTP Secret (optional - for Codex 2FA after OAuth)" />
                                        <Button Panel.ZIndex="1"
                                                Content="{Binding TotpVisibilityButtonText}"
                                                ToolTip="{Binding TotpVisibilityToolTip}"
                                                Click="ToggleCodexTotpVisibility_Click"
                                                FontSize="9"
                                                Padding="2,1"
                                                Width="26"
                                                Height="22"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Margin="0,0,6,0" />
                                    </Grid>

                                    <!-- Edit/Save Button -->
                                    <Button Grid.Column="6"
                                            Content="{Binding ActionButtonText}"
                                            Command="{Binding DataContext.SaveCodexRowCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}"
                                            Padding="8,4"
                                            Margin="4,0" />

                                    <!-- Login Button -->
                                    <Button Grid.Column="7"
                                            Content="🚀"
                                            ToolTip="Login this profile"
                                            Command="{Binding DataContext.LoginCodexRowCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding HasCredentials}"
                                            Padding="8,4"
                                            Margin="4,0" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel Grid.Row="3" Orientation="Horizontal">
                        <Button AutomationProperties.AutomationId="RemoveCodexConnectionButton"
                                Content="🗑️ Remove" Style="{StaticResource DialogButtonStyle}"
                                Click="RemoveCodexConnection_Click"
                                IsEnabled="{Binding CanRemoveCodexConnection}"
                                Margin="0" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Kiro Tab with Inline Editing -->
            <TabItem AutomationProperties.AutomationId="KiroTab" Header="Kiro (AWS)">
                <Grid Margin="12" Grid.IsSharedSizeScope="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Manage Kiro (AWS Builder ID) authentication. Choose Google OAuth (use saved Google account) or Direct Login (email+password)."
                               FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,12" />

                    <Grid Grid.Row="1" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" SharedSizeGroup="KiroSelect" />
                            <ColumnDefinition Width="120" SharedSizeGroup="KiroProfile" />
                            <ColumnDefinition Width="85" SharedSizeGroup="KiroMethod" />
                            <ColumnDefinition Width="200" SharedSizeGroup="KiroGoogleOrEmail" />
                            <ColumnDefinition Width="120" SharedSizeGroup="KiroPassword" />
                            <ColumnDefinition Width="100" SharedSizeGroup="KiroTotp" />
                            <ColumnDefinition Width="80" SharedSizeGroup="KiroEdit" />
                            <ColumnDefinition Width="60" SharedSizeGroup="KiroLogin" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="Profile" FontWeight="SemiBold" Margin="4,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="Method" FontWeight="SemiBold" Margin="4,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="Google / Email" FontWeight="SemiBold" Margin="4,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="Password" FontWeight="SemiBold" Margin="4,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="5" Text="TOTP" FontWeight="SemiBold" Margin="4,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="6" Text="Edit" FontWeight="SemiBold" Margin="4,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="7" Text="Login" FontWeight="SemiBold" Margin="4,0" VerticalAlignment="Center" />
                    </Grid>

                    <ListView AutomationProperties.AutomationId="KiroConnectionsList"
                              Grid.Row="2" ItemsSource="{Binding KiroConnections}"
                              SelectedItem="{Binding SelectedKiroConnection, Mode=TwoWay}"
                              ItemContainerStyle="{StaticResource CredentialsListItemStyle}"
                              IsEnabled="{Binding CanModifyCredentials}"
                              Margin="0,0,0,12"
                              SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" SharedSizeGroup="KiroSelect" />
                                        <ColumnDefinition Width="120" SharedSizeGroup="KiroProfile" />
                                        <ColumnDefinition Width="85" SharedSizeGroup="KiroMethod" />
                                        <ColumnDefinition Width="200" SharedSizeGroup="KiroGoogleOrEmail" />
                                        <ColumnDefinition Width="120" SharedSizeGroup="KiroPassword" />
                                        <ColumnDefinition Width="100" SharedSizeGroup="KiroTotp" />
                                        <ColumnDefinition Width="80" SharedSizeGroup="KiroEdit" />
                                        <ColumnDefinition Width="60" SharedSizeGroup="KiroLogin" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Selection Checkbox -->
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              IsEnabled="{Binding HasCredentials}"
                                              VerticalAlignment="Center" />

                                    <!-- Profile Name -->
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding ProfileName}"
                                               VerticalAlignment="Center"
                                               Margin="4,0" />

                                    <!-- Auth Method Display (when not editing) -->
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding AuthMethodDisplay}"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding IsEditable, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                               Margin="4,0" />

                                    <!-- Auth Method Dropdown (when editing) -->
                                    <ComboBox Grid.Column="2"
                                              SelectedIndex="{Binding AuthMethod, Mode=TwoWay}"
                                              Visibility="{Binding IsEditable, Converter={StaticResource BooleanToVisibilityConverter}}"
                                              VerticalAlignment="Center"
                                              Height="28"
                                              Margin="4,0">
                                        <ComboBoxItem Content="Google" />
                                        <ComboBoxItem Content="Direct" />
                                    </ComboBox>

                                    <!-- Google Account ComboBox OR Email TextBox -->
                                    <ComboBox Grid.Column="3"
                                              ItemsSource="{Binding DataContext.ConfiguredGoogleAccounts, RelativeSource={RelativeSource AncestorType=ListView}}"
                                              DisplayMemberPath="Email"
                                              SelectedValue="{Binding LinkedGoogleAccount, Mode=TwoWay}"
                                              SelectedValuePath="Email"
                                              IsEnabled="{Binding IsEditable}"
                                              Visibility="{Binding IsGoogleOAuth, Converter={StaticResource BooleanToVisibilityConverter}}"
                                              VerticalAlignment="Center"
                                              Height="28"
                                              Margin="4,0" />
                                    <TextBox Grid.Column="3"
                                             Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                             IsReadOnly="{Binding IsEditable, Converter={StaticResource InverseBooleanConverter}}"
                                             Visibility="{Binding IsDirect, Converter={StaticResource BooleanToVisibilityConverter}}"
                                             VerticalAlignment="Center"
                                             Height="28"
                                             Padding="6,4"
                                             Margin="4,0" />

                                    <!-- Password (Direct only) -->

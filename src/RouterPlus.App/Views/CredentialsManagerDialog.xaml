<Window x:Class="RouterPlus.App.Views.CredentialsManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:RouterPlus.App"
        xmlns:converters="clr-namespace:RouterPlus.App.Converters"
        Title="🔐 Credentials Manager"
        Width="920" Height="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinWidth="880" MinHeight="500"
        Background="{DynamicResource SurfaceBrush}">
    <Window.Resources>
        <converters:NullToFalseConverter x:Key="NullToFalseConverter" />
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="CredentialsListItemStyle" TargetType="{x:Type ListViewItem}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TabControl -->
        <TabControl Grid.Row="0" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
            <!-- Google Accounts Tab -->
            <TabItem AutomationProperties.AutomationId="GoogleAccountsTab" Header="Google">
                <Grid Margin="12" Grid.IsSharedSizeScope="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Manage Google accounts for OAuth authentication. Check profiles to batch login."
                               FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,12" />

                    <Grid Grid.Row="1" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" SharedSizeGroup="CredentialsSelect" />
                            <ColumnDefinition Width="140" SharedSizeGroup="CredentialsProfile" />
                            <ColumnDefinition Width="240" SharedSizeGroup="CredentialsEmail" />
                            <ColumnDefinition Width="140" SharedSizeGroup="CredentialsPassword" />
                            <ColumnDefinition Width="120" SharedSizeGroup="CredentialsTotp" />
                            <ColumnDefinition Width="70" SharedSizeGroup="CredentialsEdit" />
                            <ColumnDefinition Width="70" SharedSizeGroup="CredentialsLogin" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="Profile" FontWeight="SemiBold" Margin="4,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="Email" FontWeight="SemiBold" Margin="4,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="Password" FontWeight="SemiBold" Margin="4,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="TOTP Secret" FontWeight="SemiBold" Margin="4,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="5" Text="Edit" FontWeight="SemiBold" Margin="4,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="6" Text="Login" FontWeight="SemiBold" Margin="4,0" VerticalAlignment="Center" />
                    </Grid>

                    <ListView AutomationProperties.AutomationId="GoogleAccountsList"
                              Grid.Row="2" ItemsSource="{Binding GoogleAccounts}"
                              SelectedItem="{Binding SelectedGoogleAccount, Mode=TwoWay}"
                              ItemContainerStyle="{StaticResource CredentialsListItemStyle}"
                              IsEnabled="{Binding CanModifyCredentials}"
                              Margin="0,0,0,12"
                              SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" SharedSizeGroup="CredentialsSelect" />
                                        <ColumnDefinition Width="140" SharedSizeGroup="CredentialsProfile" />
                                        <ColumnDefinition Width="240" SharedSizeGroup="CredentialsEmail" />
                                        <ColumnDefinition Width="140" SharedSizeGroup="CredentialsPassword" />
                                        <ColumnDefinition Width="120" SharedSizeGroup="CredentialsTotp" />
                                        <ColumnDefinition Width="70" SharedSizeGroup="CredentialsEdit" />
                                        <ColumnDefinition Width="70" SharedSizeGroup="CredentialsLogin" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Selection Checkbox -->
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              IsEnabled="{Binding HasCredentials}"
                                              VerticalAlignment="Center" />

                                    <!-- Profile Name (Read-only) -->
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding ProfileName}"
                                               VerticalAlignment="Center"
                                               Margin="4,0" />

                                    <!-- Email (Editable) -->
                                    <TextBox AutomationProperties.AutomationId="GoogleEmailEditor"
                                             Grid.Column="2"
                                             Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                             IsReadOnly="{Binding IsEditable, Converter={StaticResource InverseBooleanConverter}}"
                                             VerticalAlignment="Center"
                                             Height="28"
                                             Padding="6,4"
                                             Margin="4,0" />

                                    <!-- Password (Editable with inline visibility toggle) -->
                                    <Grid Grid.Column="3">
                                        <PasswordBox AutomationProperties.AutomationId="GooglePasswordEditor"
                                                     app:PasswordBoxHelper.BindPassword="True"
                                                     app:PasswordBoxHelper.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEnabled="{Binding IsEditable}"
                                                     Visibility="{Binding IsPasswordVisible, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                                     VerticalAlignment="Center"
                                                     Height="28"
                                                     Padding="6,4,32,4"
                                                     Margin="4,0" />
                                        <TextBox AutomationProperties.AutomationId="GooglePasswordVisibleEditor"
                                                 Text="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 IsReadOnly="{Binding IsEditable, Converter={StaticResource InverseBooleanConverter}}"
                                                 Visibility="{Binding IsPasswordVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                 VerticalAlignment="Center"
                                                 Height="28"
                                                 Padding="6,4,32,4"
                                                 Margin="4,0" />
                                        <Button AutomationProperties.AutomationId="GooglePasswordVisibilityButton"
                                                Panel.ZIndex="1"
                                                Content="{Binding PasswordVisibilityButtonText}"
                                                ToolTip="{Binding PasswordVisibilityToolTip}"
                                                Click="TogglePasswordVisibility_Click"
                                                IsEnabled="{Binding IsEditable}"
                                                FontSize="9"
                                                Padding="2,1"
                                                Width="26"
                                                Height="22"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Margin="0,0,6,0" />
                                    </Grid>

                                    <!-- TOTP Secret (Editable with inline visibility toggle) -->
                                    <Grid Grid.Column="4">
                                        <PasswordBox AutomationProperties.AutomationId="GoogleTotpEditor"
                                                     app:PasswordBoxHelper.BindPassword="True"
                                                     app:PasswordBoxHelper.BoundPassword="{Binding TotpSecret, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEnabled="{Binding IsEditable}"
                                                     Visibility="{Binding IsTotpSecretVisible, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                                     VerticalAlignment="Center"
                                                     Height="28"
                                                     Padding="6,4,32,4"
                                                     Margin="4,0"
                                                     ToolTip="TOTP Secret (optional)" />
                                        <TextBox AutomationProperties.AutomationId="GoogleTotpVisibleEditor"
                                                 Text="{Binding TotpSecret, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 IsReadOnly="{Binding IsEditable, Converter={StaticResource InverseBooleanConverter}}"
                                                 Visibility="{Binding IsTotpSecretVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                 VerticalAlignment="Center"
                                                 Height="28"
                                                 Padding="6,4,32,4"
                                                 Margin="4,0"
                                                     ToolTip="TOTP Secret (optional)" />
                                        <Button AutomationProperties.AutomationId="GoogleTotpVisibilityButton"
                                                Panel.ZIndex="1"
                                                Content="{Binding TotpVisibilityButtonText}"
                                                ToolTip="{Binding TotpVisibilityToolTip}"
                                                Click="ToggleTotpVisibility_Click"
                                                IsEnabled="{Binding IsEditable}"
                                                FontSize="9"
                                                Padding="2,1"
                                                Width="26"
                                                Height="22"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Margin="0,0,6,0" />
                                    </Grid>

                                    <!-- Edit/Save Button -->
                                    <Button Grid.Column="5"
                                            Content="{Binding ActionButtonText}"
                                            Command="{Binding DataContext.SaveRowCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}"
                                            Padding="8,4"
                                            Margin="4,0" />

                                    <!-- Single-profile Login Button -->
                                    <Button AutomationProperties.AutomationId="GoogleLoginRowButton"
                                            Grid.Column="6"
                                            Content="🚀"
                                            ToolTip="Login this profile"
                                            Command="{Binding DataContext.LoginRowCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding HasCredentials}"
                                            Padding="8,4"
                                            Margin="4,0" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel Grid.Row="3" Orientation="Horizontal">
                        <Button AutomationProperties.AutomationId="BatchLoginButton"
                                Content="🚀 Batch Login"
                                Style="{StaticResource DialogButtonStyle}"
                                Command="{Binding BatchLoginCommand}"
                                Margin="0,0,8,0">
                            <Button.ToolTip>
                                <TextBlock>
                                    <Run Text="Login selected profiles (" />
                                    <Run Text="{Binding SelectedCount, Mode=OneWay}" />
                                    <Run Text=" selected)" />
                                </TextBlock>
                            </Button.ToolTip>
                        </Button>
                        <Button AutomationProperties.AutomationId="RemoveGoogleAccountButton"
                                Content="🗑️ Remove" Style="{StaticResource DialogButtonStyle}"
                                Click="RemoveGoogleAccount_Click"
                                IsEnabled="{Binding CanRemoveGoogleAccount}"
                                Margin="0" />
                        <Button AutomationProperties.AutomationId="StopBatchLoginButton"
                                Content="⏹ Stop Batch Login"
                                Style="{StaticResource DialogButtonStyle}"
                                Command="{Binding StopBatchLoginCommand}"
                                Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Codex Tab -->
            <TabItem AutomationProperties.AutomationId="CodexTab" Header="Codex (OpenAI)">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Manage Codex (OpenAI) authentication for each profile"
                               FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,12" />

                    <ListView AutomationProperties.AutomationId="CodexConnectionsList"
                              Grid.Row="1" ItemsSource="{Binding CodexConnections}"
                              SelectedItem="{Binding SelectedCodexConnection, Mode=TwoWay}"
                              Margin="0,0,0,12">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Profile" Width="200" DisplayMemberBinding="{Binding ProfileName}" />
                                <GridViewColumn Header="Method" Width="150" DisplayMemberBinding="{Binding PreferredMethodText}" />
                                <GridViewColumn Header="Google Account" Width="200" DisplayMemberBinding="{Binding LinkedGoogleAccount}" />
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Button Content="⚙️ Configure" Style="{StaticResource DialogButtonStyle}"
                                Click="ConfigureCodexConnection_Click"
                                IsEnabled="{Binding SelectedCodexConnection, Converter={StaticResource NullToFalseConverter}}"
                                Margin="0" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Kiro Tab -->
            <TabItem AutomationProperties.AutomationId="KiroTab" Header="Kiro (AWS)">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Manage Kiro (AWS Builder ID) authentication for each profile"
                               FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,12" />

                    <ListView AutomationProperties.AutomationId="KiroConnectionsList"
                              Grid.Row="1" ItemsSource="{Binding KiroConnections}"
                              SelectedItem="{Binding SelectedKiroConnection, Mode=TwoWay}"
                              Margin="0,0,0,12">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Profile" Width="200" DisplayMemberBinding="{Binding ProfileName}" />
                                <GridViewColumn Header="Method" Width="150" DisplayMemberBinding="{Binding PreferredMethodText}" />
                                <GridViewColumn Header="Google Account" Width="200" DisplayMemberBinding="{Binding LinkedGoogleAccount}" />
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Button Content="⚙️ Configure" Style="{StaticResource DialogButtonStyle}"
                                Click="ConfigureKiroConnection_Click"
                                IsEnabled="{Binding SelectedKiroConnection, Converter={StaticResource NullToFalseConverter}}"
                                Margin="0" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- GitHub Tab -->
            <TabItem AutomationProperties.AutomationId="GitHubTab" Header="GitHub">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Manage GitHub authentication for each profile"
                               FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,12" />

                    <ListView AutomationProperties.AutomationId="GitHubConnectionsList"
                              Grid.Row="1" ItemsSource="{Binding GitHubConnections}"
                              SelectedItem="{Binding SelectedGitHubConnection, Mode=TwoWay}"
                              Margin="0,0,0,12">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Profile" Width="200" DisplayMemberBinding="{Binding ProfileName}" />
                                <GridViewColumn Header="Method" Width="150" DisplayMemberBinding="{Binding PreferredMethodText}" />
                                <GridViewColumn Header="Google Account" Width="200" DisplayMemberBinding="{Binding LinkedGoogleAccount}" />
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Button Content="⚙️ Configure" Style="{StaticResource DialogButtonStyle}"
                                Click="ConfigureGitHubConnection_Click"
                                IsEnabled="{Binding SelectedGitHubConnection, Converter={StaticResource NullToFalseConverter}}"
                                Margin="0" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- OpenRouter Tab -->
            <TabItem AutomationProperties.AutomationId="OpenRouterTab" Header="OpenRouter">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Manage OpenRouter authentication for each profile"
                               FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,12" />

                    <ListView AutomationProperties.AutomationId="OpenRouterConnectionsList"
                              Grid.Row="1" ItemsSource="{Binding OpenRouterConnections}"
                              SelectedItem="{Binding SelectedOpenRouterConnection, Mode=TwoWay}"
                              Margin="0,0,0,12">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Profile" Width="200" DisplayMemberBinding="{Binding ProfileName}" />
                                <GridViewColumn Header="Method" Width="150" DisplayMemberBinding="{Binding PreferredMethodText}" />
                                <GridViewColumn Header="Google Account" Width="200" DisplayMemberBinding="{Binding LinkedGoogleAccount}" />
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Button Content="⚙️ Configure" Style="{StaticResource DialogButtonStyle}"
                                Click="ConfigureOpenRouterConnection_Click"
                                IsEnabled="{Binding SelectedOpenRouterConnection, Converter={StaticResource NullToFalseConverter}}"
                                Margin="0" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Status Bar with Unlock Button -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                Background="{DynamicResource PanelBrush}" CornerRadius="8" Padding="8" Margin="0,12,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           AutomationProperties.AutomationId="CredentialsManagerStatus"
                           Text="{Binding StatusMessage}"
                           TextWrapping="Wrap"
                           FontSize="10"
                           VerticalAlignment="Center" />

                <Button Grid.Column="1"
                        AutomationProperties.AutomationId="UnlockVaultButton"
                        Content="🔓 Unlock Vault"
                        Style="{StaticResource CompactButtonStyle}"
                        Click="UnlockVault_Click"
                        Visibility="{Binding IsVaultLocked, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Margin="8,0,0,0" />
            </Grid>
        </Border>

        <!-- Close Button -->
        <Button AutomationProperties.AutomationId="CredentialsManagerCloseButton"
                Grid.Row="2" Content="Close" Style="{StaticResource DialogButtonStyle}"
                Click="Close_Click" HorizontalAlignment="Right" />
    </Grid>
</Window>

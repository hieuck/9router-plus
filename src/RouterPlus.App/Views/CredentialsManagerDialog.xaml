<Window x:Class="RouterPlus.App.Views.CredentialsManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🔐 Credentials Manager"
        Width="800" Height="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinWidth="700" MinHeight="500"
        Background="{DynamicResource SurfaceBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Quản Lý Credentials"
                   FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16" />

        <!-- Tab Control -->
        <TabControl Grid.Row="1" Margin="0,0,0,16">

            <!-- Google Accounts Tab -->
            <TabItem Header="🔑 Google Accounts">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Quản lý Google accounts dùng cho OAuth login"
                               FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,12" />

                    <!-- Google Accounts List -->
                    <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            Background="{DynamicResource PanelBrush}" CornerRadius="8" Padding="8" Margin="0,0,0,12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding GoogleAccounts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Email}" FontSize="12" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding TotpIndicator}" FontSize="10"
                                                               Foreground="{DynamicResource MutedTextBrush}" />
                                                </StackPanel>

                                                <Button Grid.Column="1" Content="✏️ Edit"
                                                        Style="{StaticResource CompactButtonStyle}"
                                                        Click="EditGoogleAccount_Click"
                                                        Tag="{Binding Email}"
                                                        Margin="0,0,8,0" />
                                                <Button Grid.Column="2" Content="🗑️ Delete"
                                                        Style="{StaticResource CompactButtonStyle}"
                                                        Click="DeleteGoogleAccount_Click"
                                                        Tag="{Binding Email}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <Button Grid.Row="2" Content="➕ Add Google Account"
                            Style="{StaticResource DialogButtonStyle}"
                            Click="AddGoogleAccount_Click"
                            HorizontalAlignment="Left" />
                </Grid>
            </TabItem>

            <!-- Codex Tab -->
            <TabItem Header="✨ Codex">
                <Grid Margin="12">
                    <TextBlock Text="Codex provider connections - Coming soon"
                               FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                </Grid>
            </TabItem>

            <!-- Kiro Tab -->
            <TabItem Header="🚀 Kiro">
                <Grid Margin="12">
                    <TextBlock Text="Kiro provider connections - Coming soon"
                               FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                </Grid>
            </TabItem>

            <!-- GitHub Tab -->
            <TabItem Header="🐙 GitHub">
                <Grid Margin="12">
                    <TextBlock Text="GitHub provider connections - Coming soon"
                               FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                </Grid>
            </TabItem>

            <!-- OpenRouter Tab -->
            <TabItem Header="🧠 OpenRouter">
                <Grid Margin="12">
                    <TextBlock Text="OpenRouter provider connections - Coming soon"
                               FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                Background="{DynamicResource PanelBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="10"
                       Foreground="{DynamicResource MutedTextBrush}" MaxHeight="60" />
        </Border>

        <!-- Action Buttons -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1" Content="Close"
                    Style="{StaticResource DialogButtonStyle}"
                    Click="Close_Click" />
        </Grid>
    </Grid>
</Window>

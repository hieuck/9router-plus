<Window x:Class="RouterPlus.App.Views.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:RouterPlus.App.ViewModels"
        xmlns:obs="clr-namespace:RouterPlus.Infrastructure.Observability;assembly=RouterPlus.Infrastructure"
        mc:Ignorable="d"
        Title="Diagnostics - RouterPlus"
        Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfaceBrush}">


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Diagnostics Panel" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock Text="View and export observability events" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🔄 Refresh" Command="{Binding RefreshCommand}" Padding="12,6" Margin="0,0,8,0"
                            Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                    <Button Content="📤 Export" Command="{Binding ExportCommand}" Padding="12,6" Margin="0,0,8,0"
                            Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                    <Button Content="🗑️ Clear" Command="{Binding ClearLogsCommand}" Padding="12,6" Margin="0,0,8,0"
                            Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                    <Button Content="📁 Open Folder" Command="{Binding OpenLogFolderCommand}" Padding="12,6"
                            Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <TabControl Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderThickness="0" Padding="0">
            <!-- Events Tab -->
            <TabItem Header="Events" Padding="12,6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Filters -->
                    <Border Grid.Row="0" Background="{DynamicResource PanelLightBrush}" Padding="16" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Category:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"/>

                            <TextBlock Grid.Column="3" Text="Level:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox Grid.Column="4" ItemsSource="{Binding Levels}" SelectedItem="{Binding SelectedLevel}"/>

                            <TextBox Grid.Column="6" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalAlignment="Center" Padding="8,4">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Background">
                                                    <Setter.Value>
                                                        <VisualBrush Stretch="None" AlignmentX="Left">
                                                            <VisualBrush.Visual>
                                                                <TextBlock Text="🔍 Search events..." Foreground="{DynamicResource MutedTextBrush}" Margin="8,0,0,0"/>
                                                            </VisualBrush.Visual>
                                                        </VisualBrush>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </Grid>
                    </Border>

                    <!-- Events DataGrid -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding EventsView}" AutoGenerateColumns="False"
                              IsReadOnly="True" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                              HeadersVisibility="Column" RowHeight="40" CanUserResizeRows="False"
                              Background="{DynamicResource PanelBrush}" BorderThickness="0" SelectionMode="Single"
                              SelectedItem="{Binding SelectedEvent}" AlternatingRowBackground="{DynamicResource PanelLightBrush}"
                              AlternationCount="2"
                              MouseDoubleClick="DataGrid_MouseDoubleClick">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{DynamicResource PanelLightBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="12,8"/>
                                <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                            </Style>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource InfoSoftBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="12,10"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp, StringFormat='HH:mm:ss.fff'}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="ToolTip" Value="{Binding Timestamp, StringFormat='yyyy-MM-dd HH:mm:ss.fff'}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="Level" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource LevelBadgeStyle}">
                                            <TextBlock Text="{Binding Level}" Style="{StaticResource LevelTextStyle}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120"/>
                            <DataGridTextColumn Header="Operation" Binding="{Binding Operation}" Width="150"/>
                            <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
                        </DataGrid.Columns>

                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Copy Event" Command="{Binding CopyEventCommand}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>

                    <!-- Empty State -->
                    <Border Grid.Row="1" Background="{DynamicResource PanelBrush}"
                            Visibility="{Binding EventsView.IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Margin="32">
                            <TextBlock Text="📋" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                            <TextBlock Text="No Events Yet" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="Events will appear here as the application runs" FontSize="13"
                                       Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="Try clicking Refresh or performing actions in the app" FontSize="12"
                                       Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" FontStyle="Italic"/>
                        </StackPanel>
                    </Border>

                    <!-- Loading Overlay -->
                    <Border Grid.Row="1" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Border.Background>
                            <SolidColorBrush Color="{DynamicResource SurfaceColor}" Opacity="0.9"/>
                        </Border.Background>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="⏳ Loading..." FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Metrics Tab -->
            <TabItem Header="Metrics" Padding="12,6">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock Text="Event Metrics" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>

                        <Grid DataContext="{Binding Metrics}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Summary Cards -->
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="16" Margin="0,0,0,8" CornerRadius="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Total Events" FontSize="14" Foreground="{DynamicResource MutedTextBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding TotalEvents}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                    </Grid>
                                </Border>

                                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="16" Margin="0,0,0,8" CornerRadius="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Errors" FontSize="14" Foreground="{DynamicResource DangerBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding ErrorCount}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}"/>
                                    </Grid>
                                </Border>

                                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="16" Margin="0,0,0,8" CornerRadius="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Warnings" FontSize="14" Foreground="{DynamicResource WarningBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding WarningCount}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}"/>
                                    </Grid>
                                </Border>

                                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="16" CornerRadius="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Info" FontSize="14" Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding InfoCount}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Category Breakdown -->
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="16" CornerRadius="4">
                                    <StackPanel>
                                        <TextBlock Text="Events by Category" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                        <ItemsControl ItemsSource="{Binding CategoryCounts}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Key}" FontSize="13" Foreground="{DynamicResource MutedTextBrush}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="{DynamicResource PanelLightBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,16,0">
                        <Run Text="Session: "/>
                        <Run Text="{Binding SessionId, Mode=OneWay}" FontFamily="Consolas"/>
                    </TextBlock>
                    <TextBlock FontSize="11" Foreground="{DynamicResource MutedTextBrush}">
                        <Run Text="Events: "/>
                        <Run Text="{Binding EventsView.Count, Mode=OneWay}" FontWeight="SemiBold"/>
                        <Run Text="/"/>
                        <Run Text="{Binding TotalEventCount, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

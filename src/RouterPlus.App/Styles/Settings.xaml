<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Settings panel specific styles -->

    <!-- Settings Section Style (card container) -->
    <Style x:Key="SettingsSectionStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PanelLightBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="13" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!-- Settings Section Title Style -->
    <Style x:Key="SettingsSectionTitleStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,3" />
    </Style>

    <!-- Settings Section Description Style -->
    <Style x:Key="SettingsSectionDescriptionStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Margin" Value="0,0,0,14" />
    </Style>

    <!-- Settings Field Label Style -->
    <Style x:Key="SettingsFieldLabelStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Margin" Value="0,0,0,5" />
    </Style>

    <!-- Settings Field Hint Style -->
    <Style x:Key="SettingsFieldHintStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        <Setter Property="FontSize" Value="9" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

    <!-- Settings Status Style (validation feedback) -->
    <Style x:Key="SettingsStatusStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PanelLightBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="0,0,0,14" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasUnsavedSettings}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding HasSettingsValidationError}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Settings Status Text Style -->
    <Style x:Key="SettingsStatusTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasUnsavedSettings}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding HasSettingsValidationError}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>

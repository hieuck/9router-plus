<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Provider card specific styles: tags, badges, status, actions, quota -->

    <!-- Provider Workflow Tag Style (base tag style) -->
    <Style x:Key="ProviderWorkflowTagStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PanelLightBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="7,4" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <!-- Provider Status Badge Style (health indicator) -->
    <Style x:Key="ProviderStatusBadgeStyle" TargetType="Border" BasedOn="{StaticResource ProviderWorkflowTagStyle}">
        <Setter Property="Margin" Value="6,0,0,0" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsHealthy}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding HasError}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Provider Action Icon Button Style -->
    <Style x:Key="ProviderActionIconButtonStyle" TargetType="Border" BasedOn="{StaticResource ProviderWorkflowTagStyle}">
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="MinWidth" Value="26" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- Provider Header Icon Button Style -->
    <Style x:Key="ProviderHeaderIconButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Provider Status Dot Style (colored indicator) -->
    <Style x:Key="ProviderStatusDotStyle" TargetType="Ellipse">
        <Setter Property="Fill" Value="{DynamicResource BorderBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsHealthy}" Value="True">
                <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding HasError}" Value="True">
                <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Provider Status Text Style -->
    <Style x:Key="ProviderStatusTextStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="FontSize" Value="9" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsHealthy}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding HasError}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Provider Quota Panel Style (quota display container) -->
    <Style x:Key="ProviderQuotaPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PanelLightBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="0,12,0,0" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Connections.Count}" Value="0">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Provider Quota Rows Style -->
    <Style x:Key="ProviderQuotaRowsStyle" TargetType="ItemsControl">
        <Style.Triggers>
            <DataTrigger Binding="{Binding QuotaRows.Count}" Value="0">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Provider Quota Empty Style (no quota data message) -->
    <Style x:Key="ProviderQuotaEmptyStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        <Setter Property="FontSize" Value="10" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding QuotaRows.Count}" Value="0">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Provider Quota Marker Style (colored bullet) -->
    <Style x:Key="ProviderQuotaMarkerStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Text" Value="●" />
        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
        <Setter Property="Margin" Value="0,0,5,0" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsNearLimit}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsOverLimit}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Provider Action Button Style (provider card actions) -->
    <Style x:Key="ProviderActionButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Width" Value="100" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Margin" Value="0,0,4,8" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Utility Button Style (general utility buttons) -->
    <Style x:Key="UtilityButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinWidth" Value="100" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Utility Toggle Button Style -->
    <Style x:Key="UtilityToggleButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
        <Setter Property="MinWidth" Value="72" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Provider Primary Action Button Style (emphasized actions) -->
    <Style x:Key="ProviderPrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="Foreground" Value="{DynamicResource AvatarTextBrush}" />
        <Setter Property="Width" Value="100" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Margin" Value="0,0,4,8" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
</ResourceDictionary>

<Window x:Class="RouterPlus.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Giới thiệu"
        Icon="Assets/RouterPlus.ico"
        Width="520"
        Height="365"
        MinWidth="460"
        MinHeight="320"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <Border Width="64" Height="64" CornerRadius="16" Background="{DynamicResource AccentDarkBrush}">
                <Image Source="Assets/RouterPlus.ico" Width="42" Height="42" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding ProductName}" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="Windows utility cho 9Router và Chrome profile" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,5,0,0" />
            </StackPanel>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="14" Margin="0,22,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Phiên bản" Foreground="{DynamicResource MutedTextBrush}" />
                <TextBlock Grid.Column="1" Text="{Binding Version}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                <TextBlock Grid.Row="1" Text="Giấy phép" Foreground="{DynamicResource MutedTextBrush}" Margin="0,10,0,0" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LicenseName}" HorizontalAlignment="Right" Margin="0,10,0,0" />
            </Grid>
        </Border>
        <StackPanel Grid.Row="2" Margin="0,22,0,0">
            <TextBlock Text="Liên kết công khai" FontSize="13" FontWeight="SemiBold" />
            <TextBlock Text="Các liên kết này không chứa profile, key, email hoặc dữ liệu máy." Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,12" />
            <WrapPanel>
                <Button Content="Mã nguồn" Click="Repository_Click" Margin="0,0,8,8" />
                <Button Content="Hướng dẫn" Click="Help_Click" Margin="0,0,8,8" />
                <Button Content="Bảo mật" Click="Security_Click" Margin="0,0,8,8" />
                <Button Content="Release" Click="Release_Click" Margin="0,0,8,8" />
            </WrapPanel>
        </StackPanel>
        <Button Grid.Row="3" Content="Đóng" IsDefault="True" IsCancel="True" HorizontalAlignment="Right" MinWidth="90" Click="Close_Click" />
    </Grid>
</Window>
